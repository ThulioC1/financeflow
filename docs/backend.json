
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Representa um usuário do aplicativo FinanceFlow.",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Identificador único para o usuário (Firebase Auth UID)."
        },
        "nome": {
          "type": "string",
          "description": "O nome completo do usuário."
        },
        "email": {
          "type": "string",
          "description": "O endereço de e-mail do usuário.",
          "format": "email"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicando quando a conta do usuário foi criada.",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "nome",
        "email",
        "createdAt"
      ]
    },
    "Income": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Receita",
      "type": "object",
      "description": "Representa uma entrada de receita para um usuário.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador único para a entrada de receita.",
          "format": "uuid"
        },
        "userId": {
          "type": "string",
          "description": "Referência ao usuário que possui esta receita."
        },
        "valor": {
          "type": "number",
          "description": "O valor da receita."
        },
        "tipo": {
          "type": "string",
          "description": "O tipo de receita (e.g., mensal, quinzena 1, quinzena 2, extra).",
          "enum": [
            "mensal",
            "quinzena 1",
            "quinzena 2",
            "extra"
          ]
        },
        "mesReferencia": {
          "type": "string",
          "description": "O mês a que a receita se refere (AAAA-MM)."
        },
        "status": {
          "type": "string",
          "description": "O status da receita (e.g., pendente, pago)."
        },
        "dataRecebimento": {
          "type": "string",
          "description": "A data em que a receita foi recebida.",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicando quando a entrada de receita foi criada.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "valor",
        "tipo",
        "mesReferencia",
        "status",
        "createdAt"
      ]
    },
    "Expense": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Despesa",
      "type": "object",
      "description": "Representa uma entrada de despesa para um usuário.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador único para a entrada de despesa.",
          "format": "uuid"
        },
        "userId": {
          "type": "string",
          "description": "Referência ao usuário que possui esta despesa."
        },
        "descricao": {
          "type": "string",
          "description": "Uma descrição da despesa."
        },
        "valor": {
          "type": "number",
          "description": "O valor da despesa."
        },
        "categoria": {
          "type": "string",
          "description": "A categoria da despesa."
        },
        "recorrente": {
          "type": "boolean",
          "description": "Indica se a despesa é recorrente."
        },
        "mesReferencia": {
          "type": "string",
          "description": "O mês a que a despesa se refere (AAAA-MM)."
        },
        "status": {
          "type": "string",
          "description": "O status da despesa (e.g., pago, pendente)."
        },
        "dataPagamento": {
          "type": "string",
          "description": "A data em que a despesa foi paga.",
          "format": "date-time"
        },
        "dataVencimento": {
          "type": "string",
          "description": "A data de vencimento da despesa.",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicando quando a entrada de despesa foi criada.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "descricao",
        "valor",
        "categoria",
        "recorrente",
        "mesReferencia",
        "status",
        "createdAt"
      ]
    },
    "Balance": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Saldo",
      "type": "object",
      "description": "Representa o saldo de um usuário para um mês específico.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador único para a entrada de saldo.",
          "format": "uuid"
        },
        "userId": {
          "type": "string",
          "description": "Referência ao usuário que possui este saldo."
        },
        "mesReferencia": {
          "type": "string",
          "description": "O mês a que o saldo se refere (AAAA-MM)."
        },
        "saldoInicial": {
          "type": "number",
          "description": "O saldo inicial do mês."
        },
        "totalReceitas": {
          "type": "number",
          "description": "O total de receitas do mês."
        },
        "totalDespesas": {
          "type": "number",
          "description": "O total de despesas do mês."
        },
        "saldoFinal": {
          "type": "number",
          "description": "O saldo final do mês."
        }
      },
      "required": [
        "id",
        "userId",
        "mesReferencia",
        "saldoInicial",
        "totalReceitas",
        "totalDespesas",
        "saldoFinal"
      ]
    },
    "CalendarEvent": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Evento de Agenda",
      "type": "object",
      "description": "Representa um compromisso na agenda do usuário.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "location": { "type": "string" },
        "allDay": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "startDate", "endDate", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous",
      "google.com"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Armazena informações do perfil do usuário."
        }
      },
      {
        "path": "/users/{userId}/incomes/{incomeId}",
        "definition": {
          "entityName": "Income",
          "schema": {
            "$ref": "#/backend/entities/Income"
          },
          "description": "Armazena entradas de receita."
        }
      },
      {
        "path": "/users/{userId}/expenses/{expenseId}",
        "definition": {
          "entityName": "Expense",
          "schema": {
            "$ref": "#/backend/entities/Expense"
          },
          "description": "Armazena entradas de despesa."
        }
      },
      {
        "path": "/users/{userId}/balances/{balanceId}",
        "definition": {
          "entityName": "Balance",
          "schema": {
            "$ref": "#/backend/entities/Balance"
          },
          "description": "Armazena informações de saldo."
        }
      },
      {
        "path": "/users/{userId}/events/{eventId}",
        "definition": {
          "entityName": "CalendarEvent",
          "schema": {
            "$ref": "#/backend/entities/CalendarEvent"
          },
          "description": "Armazena compromissos da agenda do usuário."
        }
      }
    ]
  }
}
